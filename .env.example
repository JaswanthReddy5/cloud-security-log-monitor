# Copy to .env for local development. NEVER commit real values.

# PostgreSQL connection string (Neon / Supabase / any Postgres).
# Leave empty locally to use the built-in SQLite file (backend/instance/local.db).
# In production this is REQUIRED (set automatically by the Vercel + Neon integration).
DATABASE_URL=

# Long random string. Required for admin actions (reset data, change thresholds).
# Generate one with:  python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me

# Random salt used to hash visitor IPs for rate limiting (raw IPs are never stored).
IP_HASH_SALT=change-me-too

# Comma-separated list of allowed cross-origin frontends (only needed if the
# frontend is hosted on a different domain than the API).
CORS_ORIGINS=

# Optional overrides (defaults shown)
# APP_ENV=development
# MAX_UPLOAD_BYTES=2097152
# MAX_RECORDS_PER_INGEST=5000
# MAX_STORED_EVENTS=20000
# RATE_LIMIT_INGEST_PER_10MIN=20
# IP_FAILURE_THRESHOLD=5
# IP_FAILURE_WINDOW_MINUTES=5
